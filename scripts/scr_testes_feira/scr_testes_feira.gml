    _j.confirmacao={acao:"comprar_faltante"};compras_passo(_j,60);_exigir(compras_motoboy_restante(_j)==9,"leitura da confirmação não consome o prazo da entrega");confirmacao_fechar(_j);
    historia_enfileirar(_j,"q_estoque",true);compras_passo(_j,60);_exigir(compras_motoboy_restante(_j)==9,"quiz congela o motoboy junto com o relógio");historia_fechar(_j);
    teste_exploracao_posicionar(_j,"producao","deposito");compras_passo(_j,8.99);
    _exigir(_j.compras[0].status=="em_transito" && estoque_quantidade(_j.estoque.materias_primas,"queijo")==0,"ingrediente não entra antes do prazo exato");
    _exigir(compras_passo(_j,.02)==1 && _j.compras[0].status=="recebida" && _j.dia==1 && estoque_quantidade(_j.estoque.materias_primas,"queijo")==40,"entrega chega ao estoque no mesmo dia mesmo em outro setor");
    _exigir(_j.exploracao.entregas_motoboy==1 && _j.exploracao.aviso_entrega_segundos==7 && compras_motoboy_visual(_j).saindo && canhoto_dados(_j).comprar==0,"chegada mostra aviso e moto saindo e libera retirada");
    var _recebido_moto=estoque_quantidade(_j.estoque.materias_primas,"queijo");compras_passo(_j,100);compras_receber(_j,[]);
    _exigir(estoque_quantidade(_j.estoque.materias_primas,"queijo")==_recebido_moto && _j.financas.saldo_centavos==_caixa_moto-2800 && _j.exploracao.entregas_motoboy==1 && simulacao_auditar(_j).ok,"entrega repetida não duplica estoque, taxa ou pagamento");
    teste_missao_abastecer(_j,_j.pedidos[0]);teste_exploracao_posicionar(_j,"producao","bancada");exploracao_produzir(_j,"bolinha_queijo",20);teste_exploracao_posicionar(_j,"comercial","entrega");pedido_entregar(_j,_j.pedidos[0]);
    _exigir(array_length(_j.missoes.entregues)==1 && simulacao_auditar(_j).ok,"ingredientes do motoboy permitem produzir e entregar a missão normalmente");
    // Itens múltiplos chegam em lote e só no almoxarifado, nunca na mochila/cozinha.
    _j=feira_criar();global.jogo=_j;teste_missao_consultar(_j);teste_exploracao_posicionar(_j,"estoque","compras");compra_realizar(_j,"farinha",2);compra_realizar(_j,"oleo",3);
    _exigir(compras_passo(_j,12)==2 && _j.exploracao.entregas_motoboy==2 && estoque_quantidade(_j.estoque.materias_primas,"farinha")==122 && estoque_quantidade(_j.estoque.materias_primas,"oleo")==203,"uma chegada recebe todos os volumes da encomenda");
    _exigir(exploracao_carregado_total(_j)==0 && estoque_quantidade(_j.cozinha,"farinha")==0 && simulacao_auditar(_j).ok,"recebimento respeita transporte e conservação dos materiais");
    global.jogo=_original;_t.ok=array_length(_t.falhas)==0;show_debug_message("FDS_FEIRA_TESTES: "+string(_t.total)+" / FALHAS: "+string(array_length(_t.falhas)));return _t;
